# ===== CoinDrop Rewards — Server Environment Variables =====
# Copy this file to ".env" in the same folder and fill in your own values.
# NEVER commit the real .env file to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or MongoDB Atlas free tier — no external paid keys required)
MONGO_URI=mongodb://127.0.0.1:27017/coindrop_rewards

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# CORS — the frontend origin(s) allowed to call this API.
# server.js already whitelists these by default, even if this is unset:
#   https://coindrop.shop
#   https://www.coindrop.shop
#   https://coindrop-rewards.vercel.app
#   http://localhost:5173
# Use CLIENT_URL only to ADD an extra origin (e.g. a Vercel preview URL),
# as a comma-separated list if more than one:
CLIENT_URL=https://www.coindrop.shop

# Economy rules
POINTS_PER_AD_VIEW=40
AD_MIN_WATCH_SECONDS=15
REDEEM_POINTS_THRESHOLD=25000
REDEEM_CASH_VALUE_INR=50

# Anti-fraud / high-frequency ad guards
AD_DAILY_LIMIT=40
AD_LIMIT_WINDOW_HOURS=12
AD_COOLDOWN_SECONDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=200
